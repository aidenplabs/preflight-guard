{
  "name": "preflight-security-checker",
  "version": "0.1.0",
  "private": true,
  "description": "CLI-first heuristic pre-deploy checker centered on Next.js, with deeper Supabase and Vercel pack support.",
  "type": "module",
  "bin": {
    "preflight": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "scan": "tsx src/cli.ts scan",
    "check": "tsc --noEmit -p tsconfig.json",
    "validate:execution-help": "node scripts/validate-execution-help-boundary.mjs",
    "validate:curated": "node scripts/run-curated-validation.mjs",
    "validate:curated:report": "node scripts/report-curated-validation.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
